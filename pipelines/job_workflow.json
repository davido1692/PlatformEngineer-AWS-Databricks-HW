{
  "name": "landing-to-curated-workflow",
  "email_notifications": {
    "on_failure": ["dataops@example.com"]
  },
  "tasks": [
    {
      "task_key": "ingest_curate",
      "notebook_task": {
        "notebook_path": "/Repos/your-org/your-repo/pipelines/landing_to_curated"
      },
      "job_cluster_key": "job_cluster",
      "max_retries": 2,
      "min_retry_interval_millis": 60000
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "job_cluster",
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "m6i.xlarge",
        "driver_node_type_id": "m6i.xlarge",
        "num_workers": 2,
        "autotermination_minutes": 15,
        "aws_attributes": {
          "instance_profile_arn": "__REPLACE_WITH_INSTANCE_PROFILE_ARN__"
        }
      }
    }
  ]
}
